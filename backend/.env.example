# Block29 Admin backend - environment template
# Copy to backend/.env (never commit .env - it is gitignored) or set in your
# deployment platform. Generate strong secrets with: scripts/generate-secrets.sh

# --- Database (use the ROTATED password - the old one is in public git history) ---
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# --- Auth (REQUIRED - server refuses to start without JWT_SECRET) ---
JWT_SECRET=

# --- First-admin seeding (optional; only used if the email doesn't exist yet) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- CORS: set to the admin frontend origin(s), comma-separated. Never '*' in production ---
CORS_ORIGINS=https://admin.block29.example

# --- Behind a load balancer / reverse proxy? Set to the number of trusted hops
#     so rate limiting and audit IPs use the real client address. 0 = direct. ---
TRUSTED_PROXY_HOPS=1

# --- Payment Hub (AsterPOSPaymentHub) ---
PAYMENT_HUB_URL=https://www.123cents.com
PAYMENT_HUB_ADMIN_KEY=
PAYMENT_HUB_ENV=production
PAYMENT_HUB_TIMEOUT_SECONDS=10
